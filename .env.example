# SmartFactory 4.0 Environment Configuration
# Copy this file to .env and adjust values

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/smartfactory.db
SECRET_KEY=smartfactory-dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MQTT (Optional - system works without it)
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartfactory

# Simulation
SIMULATION_AUTO_START=false
SENSOR_UPDATE_INTERVAL_MS=2000
DEFAULT_DEFECT_PROBABILITY=0.15

# Data Retention
SENSOR_HISTORY_RETENTION_HOURS=24
MAX_SENSOR_READINGS=50000
